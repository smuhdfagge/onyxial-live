APP_NAME="Onyx Investment Advisory Limited"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://onyxial.com
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# First admin account, created by `php artisan db:seed`.
# If ADMIN_PASSWORD is left empty a random one is generated and printed once.
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=admin@onyxial.com
ADMIN_PASSWORD=

# Database. MySQL is typical on cPanel hosting; SQLite works for small sites and testing.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onyxial
DB_USERNAME=
DB_PASSWORD=
# DB_CONNECTION=sqlite   (and delete the DB_* lines above)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Email for contact-form notifications (e.g. the hosting account's SMTP details)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.onyxial.com
MAIL_PORT=465
MAIL_USERNAME=info@onyxial.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@onyxial.com"
MAIL_FROM_NAME="${APP_NAME}"
